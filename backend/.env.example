# GREENPULSE - Environment Configuration
APP_NAME="GREENPULSE"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api"

# Database Configuration (PostgreSQL / SQLite fallback for development)
# Production PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/greenpulse_db
# SQLite local development default:
DATABASE_URL=sqlite:///./greenpulse.db

# Authentication / Security
JWT_SECRET_KEY=greenpulse-super-secret-production-key-2026-climate-intelligence-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# External Climate & Weather APIs
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
EXTERNAL_API_TIMEOUT_SECONDS=10.0

# CORS Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# Demo Mode - Enable clear demonstration mock data fallback
DEMO_MODE=True

